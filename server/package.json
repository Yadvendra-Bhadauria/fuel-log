{
  "name": "@fuel-log/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate": "npx --yes --package=prisma@6.19.3 prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "db:push": "dotenv -e ../.env -- prisma db push --schema prisma/schema.prisma",
    "db:studio": "dotenv -e ../.env -- prisma studio --schema prisma/schema.prisma",
    "db:turso:init": "dotenv -e ../.env -- tsx scripts/init-turso.ts"
  },
  "dependencies": {
    "@fuel-log/shared": "1.0.0",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
